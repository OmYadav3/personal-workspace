{
   "name": "personal-workspace",
   "version": "1.0.0",
   "private": true,
   "type": "module",
   "workspaces": [
      "apps/api",
      "apps/web",
      "packages/shared"
   ],
   "scripts": {
      "dev:api": "npm run dev -w @personal-workspace/api",
      "dev:web": "npm run dev -w @personal-workspace/web",
      "build:shared": "npm run build -w @personal-workspace/shared",
      "typecheck:api": "npm run typecheck -w @personal-workspace/api",
      "build:web": "npm run build -w @personal-workspace/web",
      "build": "npm run build:shared && npm run typecheck:api && npm run build:web",
      "test": "npm run test --workspaces --if-present",
      "lint": "npm run lint --workspaces --if-present",
      "format": "prettier --write .",
      "format:check": "prettier --check ."
   },
   "overrides": {
      "ts-api-utils": {
         "typescript": "6.0.3"
      }
   },
   "devDependencies": {
      "prettier": "^3.9.10"
   }
}